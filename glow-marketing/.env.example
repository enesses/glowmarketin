# Bu dosyanın adını .env olarak değiştir ve anahtarını yapıştır.
# .env dosyasını asla paylaşma ya da GitHub'a yükleme.
DEEPSEEK_API_KEY=sk-buraya-anahtarini-yaz

# AI video (Max): Seedance modelini çalıştıracak sağlayıcı. İkisinden biri yeterli.
# fal.ai → https://fal.ai/dashboard/keys    OpenRouter → https://openrouter.ai/keys
FAL_KEY=
OPENROUTER_API_KEY=
# auto (önce fal.ai, yoksa OpenRouter) | fal | openrouter
VIDEO_PROVIDER=auto
VIDEO_MODEL=seedance-2.5
VIDEO_RESOLUTION=720p
VIDEO_LIMIT_PER_HOUR=6

# Bu sunucunun dışarıdan erişilen https adresi. Instagram görselleri ve AI videolar bu adresten okunur.
PUBLIC_URL=https://api.alanadin.com

# Site / mobil uygulama bu sunucudan farklı bir adreste yayınlanıyorsa,
# o adresleri virgülle yaz (mobil uygulama için capacitor://localhost ve http://localhost).
ALLOWED_ORIGINS=https://alanadin.com,https://www.alanadin.com,capacitor://localhost,http://localhost

# İsteğe bağlı ayarlar
# Görsel/video klasörü (Render'da kalıcı disk: /var/data/uploads)
UPLOADS_DIR=
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=3000
RATE_LIMIT_PER_MIN=20
# Sunucunun önündeki vekil (proxy) sayısı. Render/Railway/Nginx arkasında 1; doğrudan internete açıksa 0.
# Yanlış verilirse hız sınırı ya herkesi tek kişi sayar ya da sahte IP başlığıyla aşılabilir.
TRUST_PROXY=1
